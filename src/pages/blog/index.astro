---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import StartHere from '../../components/StartHere.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const formatDate = (date: Date) => date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
const readingTime = (body: string) => `${Math.max(1, Math.ceil(body.split(/\s+/).length / 200))} min read`;

const [featured, ...rest] = posts;
---

<Layout title="Journal" description="Destination guides, travel thinking, and notes from the road by Zak Winnick." noindex>
  <PageHero eyebrow="The Wyld Wandering journal" intro="Destination guides, travel thinking, and notes on exploring the world with intention and comfort.">
    Journal
  </PageHero>

  <section class="py-20 md:py-28">
    <div class="container-site flex flex-col gap-16">
      {
        featured && (
          <a href={`/blog/${featured.id}`} class="reveal group grid items-center gap-10 text-ink hover:text-ink lg:grid-cols-12">
            {featured.data.image && (
              <div class="overflow-hidden rounded-card lg:col-span-7">
                <img src={featured.data.image} alt="" class="aspect-[16/10] w-full object-cover transition-transform duration-700 group-hover:scale-[1.03]" loading="eager" />
              </div>
            )}
            <div class="flex flex-col gap-4 lg:col-span-5">
              <span class="eyebrow">{featured.data.category}</span>
              <h2 class="display-md group-hover:text-clay">{featured.data.title}</h2>
              <p class="text-ink-700">{featured.data.excerpt}</p>
              <p class="text-sm text-ink-600">
                <time datetime={featured.data.date.toISOString()}>{formatDate(featured.data.date)}</time> · {readingTime(featured.body)}
              </p>
            </div>
          </a>
        )
      }

      {
        rest.length > 0 && (
          <div class="grid gap-x-8 gap-y-14 border-t border-sand-300 pt-14 md:grid-cols-2 lg:grid-cols-3">
            {rest.map((post) => (
              <a href={`/blog/${post.id}`} class="reveal group flex flex-col gap-4 text-ink hover:text-ink">
                {post.data.image && (
                  <div class="overflow-hidden rounded-card">
                    <img src={post.data.image} alt="" class="aspect-[4/3] w-full object-cover transition-transform duration-700 group-hover:scale-[1.03]" loading="lazy" />
                  </div>
                )}
                <span class="text-xs font-medium uppercase tracking-[0.2em] text-clay">{post.data.category}</span>
                <h3 class="text-[30px] leading-tight group-hover:text-clay">{post.data.title}</h3>
                <p class="text-ink-600">{post.data.excerpt}</p>
                <p class="text-sm text-ink-600">
                  <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time> · {readingTime(post.body)}
                </p>
              </a>
            ))}
          </div>
        )
      }

      {posts.length === 0 && <p class="text-ink-700">New posts are on the way.</p>}
    </div>
  </section>

  <StartHere />
</Layout>
