---
import Layout from '../../layouts/Layout.astro';
import StartHere from '../../components/StartHere.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await post.render();

const related = (await getCollection('blog', ({ data }) => !data.draft))
  .filter((p) => p.slug !== post.slug)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 2);

const formatDate = (date: Date) => date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
const readingTime = `${Math.max(1, Math.ceil(post.body.split(/\s+/).length / 200))} min read`;
---

<Layout title={post.data.title} description={post.data.excerpt} noindex>
  <article>
    <header class="pb-12 pt-12 md:pb-16 md:pt-20">
      <div class="container-site max-w-3xl">
        <a href="/blog" class="text-sm font-medium text-ink-600 hover:text-clay">Journal</a>
        <p class="eyebrow mt-8">{post.data.category}</p>
        <h1 class="display-lg mt-5">{post.data.title}</h1>
        <p class="mt-6 text-sm text-ink-600">
          Zak Winnick · <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time> · {readingTime}
        </p>
      </div>
    </header>

    {
      post.data.image && (
        <div class="container-site">
          <img src={post.data.image} alt="" class="aspect-[21/9] w-full rounded-card object-cover" loading="eager" />
        </div>
      )
    }

    <div class="container-site max-w-3xl py-16 md:py-20">
      <div class="prose-ww">
        <Content />
      </div>
    </div>

    <aside class="container-site max-w-3xl pb-20">
      <div class="flex flex-col gap-3 rounded-card bg-sand-200 p-8 md:p-10">
        <p class="eyebrow">About the author</p>
        <h2 class="text-[30px] leading-tight">Zak Winnick</h2>
        <p class="text-ink-700">After fifteen years in luxury hospitality, I know which hotels live up to the hype and which ones just have good photographers. I only book clients into places I'd stay at myself.</p>
        <a href="/about" class="link-accent self-start text-[15px]">More about Zak</a>
      </div>
    </aside>
  </article>

  {
    related.length > 0 && (
      <section class="border-t border-sand-300 py-20">
        <div class="container-site flex flex-col gap-10">
          <h2 class="display-md">Keep reading</h2>
          <div class="grid gap-10 md:grid-cols-2">
            {related.map((p) => (
              <a href={`/blog/${p.slug}`} class="group flex flex-col gap-3 text-ink hover:text-ink">
                <span class="text-xs font-medium uppercase tracking-[0.2em] text-clay">{p.data.category}</span>
                <h3 class="text-[30px] leading-tight group-hover:text-clay">{p.data.title}</h3>
                <p class="text-ink-600">{p.data.excerpt}</p>
              </a>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <StartHere />
</Layout>
