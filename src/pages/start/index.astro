---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import FormHidden from '../../components/FormHidden.astro';
import FormSubmitRow from '../../components/FormSubmitRow.astro';
import { formAction, SITE } from '../../config/site';

// New-client trip inquiry. Posts to the forms Worker (workers/forms), which
// emails it to hello@. Field names are readable labels because they become the
// rows of that email.
const field =
  'w-full rounded-card border border-sand-400 bg-white px-4 py-3.5 text-[16px] font-normal text-ink placeholder:text-ink-400 focus:border-clay focus:outline-hidden focus:ring-2 focus:ring-clay/25 dark:bg-sand-100';
const label = 'mb-2 block text-sm font-medium text-ink';
const req = '<span class="text-clay" aria-hidden="true">*</span>';

const help = ['Hotel only', 'Hotel and flights', 'Full itinerary', 'Group room block', 'Not sure yet'];
const budget = ['Under $5,000', '$5,000 to $10,000', '$10,000 to $25,000', '$25,000 to $50,000', 'Over $50,000'];
---

<Layout title="Start Planning" description="Tell Zak Winnick about your next trip: where, when, who's going and what would make it worth it. He'll reply within two business days.">
  <PageHero eyebrow="Start planning" intro="Tell me where you're thinking of going and what would make the trip worth it. I'll reply within two business days to set up a conversation.">
    Let's plan your <em>next trip.</em>
  </PageHero>

  <section class="py-16 md:py-24">
    <div class="container-site grid gap-14 lg:grid-cols-12 lg:gap-20">
      <form action={formAction('trip')} method="POST" class="flex flex-col gap-10 lg:col-span-7">
        <FormHidden subject="Trip Inquiry" next="/start/received/" />

        <fieldset class="flex flex-col gap-6">
          <legend class="sr-only">About You</legend>
          <p aria-hidden="true" class="font-display text-[30px] font-medium leading-tight">About You</p>
          <div class="grid gap-6 sm:grid-cols-2">
            <div>
              <label for="name" class={label}>Name <Fragment set:html={req} /></label>
              <input id="name" name="Name" type="text" required autocomplete="name" class={field} />
            </div>
            <div>
              <label for="email" class={label}>Email <Fragment set:html={req} /></label>
              <input id="email" name="email" type="email" required autocomplete="email" class={field} />
            </div>
            <div>
              <label for="phone" class={label}>Phone</label>
              <input id="phone" name="Phone" type="tel" autocomplete="tel" class={field} />
            </div>
            <div>
              <label for="based" class={label}>Where You're Based <Fragment set:html={req} /></label>
              <input id="based" name="Based in" type="text" required autocomplete="address-level2" placeholder="City, state or country" class={field} />
            </div>
          </div>
        </fieldset>

        <fieldset class="flex flex-col gap-6 border-t border-sand-300 pt-10">
          <legend class="sr-only">The Trip</legend>
          <p aria-hidden="true" class="font-display text-[30px] font-medium leading-tight">The Trip</p>
          <div>
            <label for="destination" class={label}>Where You're Thinking of Going <Fragment set:html={req} /></label>
            <input id="destination" name="Destination" type="text" required placeholder="A place, a few options, or &quot;somewhere warm in March&quot;" class={field} />
          </div>
          <div class="grid gap-6 sm:grid-cols-2">
            <div>
              <label for="dates" class={label}>Dates</label>
              <input id="dates" name="Dates" type="text" placeholder="Exact dates or a rough window" class={field} />
            </div>
            <div>
              <label for="travelers" class={label}>Who's Traveling</label>
              <input id="travelers" name="Travelers" type="text" placeholder="Two adults, a family of four..." class={field} />
            </div>
            <div>
              <label for="help" class={label}>What You'd Like Help With</label>
              <select id="help" name="Help with" class={field}>
                <option value="" selected>Choose one</option>
                {help.map((h) => <option value={h}>{h}</option>)}
              </select>
            </div>
            <div>
              <label for="budget" class={label}>Rough Budget for the Trip</label>
              <select id="budget" name="Budget" class={field}>
                <option value="" selected>Choose a range</option>
                {budget.map((b) => <option value={b}>{b}</option>)}
              </select>
            </div>
          </div>
          <div>
            <label for="looking" class={label}>What Would Make This Trip Worth It <Fragment set:html={req} /></label>
            <textarea id="looking" name="Looking for" required rows="5" class={field} placeholder="The occasion, the hotels you love, the pace you like, anything you want to avoid."></textarea>
          </div>
          <div>
            <label for="heard" class={label}>How You Heard About Wyld Wandering</label>
            <input id="heard" name="Heard about us" type="text" class={field} />
          </div>
        </fieldset>

        <div class="flex flex-col gap-5">
          <FormSubmitRow label="Send Trip Details" note="* Required. Your answers come to me by email." />
        </div>
      </form>

      <aside class="flex flex-col gap-5 lg:col-span-5">
        <div class="flex flex-col gap-5 rounded-card bg-pine p-8 text-cream-100 md:p-10 lg:sticky lg:top-28">
          <p class="text-[13px] font-medium uppercase tracking-eyebrow text-gold">What happens next</p>
          <ol class="flex flex-col">
            <li class="border-t border-cream-100/15 py-4"><span class="font-display text-[22px] text-gold">01</span><p class="mt-1 text-cream-100">I read your notes and reply within two business days.</p></li>
            <li class="border-t border-cream-100/15 py-4"><span class="font-display text-[22px] text-gold">02</span><p class="mt-1 text-cream-100">We talk through the trip: where, how you like to travel, and what to avoid.</p></li>
            <li class="border-t border-cream-100/15 py-4"><span class="font-display text-[22px] text-gold">03</span><p class="mt-1 text-cream-100">I come back with the right hotels and a plan, and we refine it together.</p></li>
          </ol>
          <p class="border-t border-cream-100/15 pt-4 text-[15px] text-pine-muted">Prefer email? Write to <a href={`mailto:${SITE.email}`} class="text-gold underline-offset-4 hover:text-gold-soft hover:underline">{SITE.email}</a>.</p>
          <a href="/services/#pricing" class="self-start text-[15px] font-medium text-gold underline-offset-4 hover:text-gold-soft hover:underline">See Pricing</a>
        </div>
      </aside>
    </div>
  </section>
</Layout>
