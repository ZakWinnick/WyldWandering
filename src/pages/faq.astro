---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import StartHere from '../components/StartHere.astro';
import Icon from '../components/Icon.astro';
import { INTAKE_URL, PORTAL_URL } from '../config/site';

interface Faq {
  q: string;
  a: string;
}

const sections: { title: string; faqs: Faq[] }[] = [
  {
    title: 'Working with a Travel Advisor',
    faqs: [
      {
        q: 'How does working with you differ from booking myself?',
        a: "When you book yourself, you're navigating endless options and hoping for the best. As your travel advisor, I bring expertise, insider connections, and genuine relationships with the world's best hotels. I handle the research, the details, and the things you didn't know to ask for. Plus, I have access to perks, upgrades, and amenities that aren't available when you book directly. Same room, same rate, but with benefits that actually make a difference.",
      },
      {
        q: 'What does it cost to use your services?',
        a: "Hotel-only bookings are complimentary. The hotel's commission covers my time, and you still get the perks. Beyond that, I charge a flat planning fee based on scope: $250 for hotel and flights, $1,000 for a full itinerary including restaurants and experiences, and from $500 for group room blocks depending on size (up to 10 rooms $500, 11 to 25 rooms $1,000, larger groups by quote). Group itineraries, multi-country trips, and events are quoted individually. For frequent travelers, there's Private Client at $5,000 a year. Once you've booked $40,000 in travel with me, you get a year as a Private Client free.",
      },
      {
        q: 'What do Private Clients get?',
        a: "Private Client is $5,000 a year, billed annually or $1,350 quarterly, by application. It covers up to six full itineraries, every hotel and hotel-and-flights booking with no planning fee, same-business-day response, concierge help on trips booked with me, and a planning call at the start of your year. Everything else is 50% off: additional itineraries, group room blocks, and events. The term runs 12 months from payment, and unused itineraries don't roll over. If no planning has started, it's fully refundable within 14 days. Once you've booked $40,000 in travel with me, you get a year as a Private Client free.",
      },
      {
        q: 'How do you get paid?',
        a: "Two ways: a planning fee that covers my time and expertise, and commissions from hotels and travel partners when I book through them. The commission structure means you pay the same room rates as booking direct, but you get access to upgrades, resort credits, and amenities you wouldn't get on your own. It's how the industry works, and it allows me to dedicate real time to crafting trips that actually deliver.",
      },
    ],
  },
  {
    title: 'Getting Started and the Client Portal',
    faqs: [
      {
        q: 'How do I get started?',
        a: "Fill out the short intake form. It sets up your traveler profile with the basics: who's traveling, where you're based, how you like to be contacted, and the hotels you already love. Then we'll set up a conversation about the trip itself.",
      },
      {
        q: 'What is the client portal?',
        a: 'Your Wyld Wandering client portal is a private space, powered by Fora, where you can browse and book hotels in collaboration with me. It keeps your options and bookings in one place.',
      },
      {
        q: 'How do I sign in to the portal?',
        a: 'Go to Client login and enter the email address or phone number on your traveler profile. If you are new, complete the intake form first so your profile exists.',
      },
    ],
  },
  {
    title: 'Planning Process',
    faqs: [
      {
        q: 'How far in advance should I book?',
        a: 'It depends on where you want to go and when. For popular destinations during peak seasons, 6 to 12 months in advance helps secure the best rooms and reservations. For high-demand experiences like Michelin restaurants, exclusive tours, or sought-after suites, even earlier is better. Last-minute trips can work too, but you may have fewer options. The earlier we start, the more doors I can open.',
      },
      {
        q: 'What information do you need to plan my trip?',
        a: "To get started, I'll want to understand your travel dates, budget range, destinations you're considering, and how you like to travel. I'll ask about your interests, what your ideal day looks like, and what you absolutely want to avoid. The more you share about what makes a trip feel worth it to you, the better I can tailor every detail.",
      },
      {
        q: 'How long does the planning process take?',
        a: "A straightforward trip might come together in 1 to 2 weeks, while a complex multi-destination itinerary could take 4 to 6 weeks. After our initial conversation, I'll provide a preliminary itinerary within a week. From there, we refine together until everything feels right.",
      },
    ],
  },
  {
    title: 'Trip Types',
    faqs: [
      {
        q: 'What kind of trips do you specialize in?',
        a: "Premium travel experiences, the kind where every detail has been considered. Luxury hotels with actual perks, restaurants that are worth the hype, and experiences that feel curated rather than packaged. Whether it's a European escape, a beach retreat, a city break, or a special occasion trip, I focus on journeys that deliver on their promise.",
      },
      {
        q: 'Do you plan trips anywhere in the world?',
        a: 'Yes. While I have particular expertise in certain destinations, I work with travelers planning trips across the globe. From the Amalfi Coast to Tokyo, the Maldives to Patagonia. Wherever you want to go, I have the relationships and resources to make it happen the right way.',
      },
      {
        q: 'Can you help with just a hotel booking?',
        a: "Absolutely. Through my partnerships with luxury hotel programs, I can secure upgrades, resort credits, early check-in, late checkout, and other VIP amenities at top properties worldwide, subject to availability. Even if you just need one exceptional hotel stay, not a full trip, I'm here to help, and hotel-only bookings are complimentary.",
      },
    ],
  },
  {
    title: 'Logistics',
    faqs: [
      {
        q: 'What happens if something goes wrong during my trip?',
        a: "This is where having a travel advisor really matters. If flights get canceled, hotels have issues, or unexpected situations come up, you have me in your corner. I'm available to troubleshoot and rearrange plans when needed. Unlike booking platforms where you're just a confirmation number, you have a real person who knows your itinerary inside and out and can advocate on your behalf.",
      },
      {
        q: 'Do you handle flights and transportation?',
        a: "Yes. I can book flights, airport transfers, car rentals, trains, and other transportation as part of your trip. I look for the best routes and values while considering how your flights connect with the rest of your itinerary. For some travelers, I recommend booking flights separately to use points or miles. I'm happy to advise on what makes sense for your situation.",
      },
      {
        q: 'What about travel insurance?',
        a: "I strongly recommend travel insurance for every trip and can help you understand your options. While I don't sell insurance directly, I'll point you toward reputable providers and help you figure out what coverage makes sense.",
      },
    ],
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: sections.flatMap((s) =>
    s.faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } }))
  ),
};
---

<Layout title="FAQ" description="Answers to common questions about working with Wyld Wandering: planning fees, the client portal, how the process works, and what happens if something goes wrong.">
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <PageHero eyebrow="Questions and answers" intro="Curious about how working with a travel advisor actually works? Here's what you need to know.">
    The details, <em>explained.</em>
  </PageHero>

  <section class="py-20 md:py-28">
    <div class="container-site flex flex-col gap-16 md:gap-20">
      {
        sections.map((section, i) => (
          <div class="reveal grid gap-6 lg:grid-cols-12 lg:gap-16">
            <div class="flex items-baseline gap-4 lg:col-span-4 lg:flex-col lg:gap-3">
              <span class="font-display text-[22px] text-clay">{String(i + 1).padStart(2, '0')}</span>
              <h2 class="text-[34px] leading-tight md:text-[40px]">{section.title}</h2>
            </div>
            <div class="lg:col-span-8">
              {section.faqs.map((f) => (
                <details class="faq group border-t border-sand-300 last:border-b">
                  <summary class="flex min-h-[64px] cursor-pointer list-none items-center justify-between gap-6 py-5 text-left text-[19px] font-normal text-ink hover:text-clay [&::-webkit-details-marker]:hidden">
                    <span>{f.q}</span>
                    <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full border border-sand-300 transition-transform duration-300 group-open:rotate-45" aria-hidden="true">
                      <Icon name="plus" class="h-4 w-4" />
                    </span>
                  </summary>
                  <p class="max-w-2xl pb-7 pr-12 text-ink-700">{f.a}</p>
                </details>
              ))}
            </div>
          </div>
        ))
      }

      <div class="reveal grid gap-5 md:grid-cols-2">
        <a href={INTAKE_URL} class="group flex items-center justify-between gap-6 rounded-card bg-sand-200 p-8 text-ink hover:text-ink md:p-10" target="_blank" rel="noopener noreferrer">
          <span class="flex flex-col gap-2">
            <span class="eyebrow">New client</span>
            <span class="font-display text-[30px] font-medium leading-tight">Start the Intake</span>
          </span>
          <Icon name="arrow" class="h-6 w-6 transition-transform group-hover:translate-x-1" />
        </a>
        <a href={PORTAL_URL} class="group flex items-center justify-between gap-6 rounded-card bg-pine p-8 text-cream-100 hover:text-cream-100 md:p-10" target="_blank" rel="noopener noreferrer">
          <span class="flex flex-col gap-2">
            <span class="text-[13px] font-medium uppercase tracking-eyebrow text-gold">Existing client</span>
            <span class="font-display text-[30px] font-medium leading-tight">Sign In to Your Portal</span>
          </span>
          <Icon name="lock" class="h-6 w-6" />
        </a>
      </div>
    </div>
  </section>

  <StartHere heading="Still have questions?" />
</Layout>
