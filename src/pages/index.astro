---
import Layout from '../layouts/Layout.astro';
import { intakeLink } from '../lib/fora';

const planFromHero = intakeLink('home-hero');
const planFromPaths = intakeLink('home-paths');
const planFromClose = intakeLink('home-close');
---

<Layout title="Wyld Wandering">
  <!-- Hero -->
  <section class="relative min-h-screen flex items-center bg-cream-50 dark:bg-charcoal-900 overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-cream-100 via-cream-50 to-cream-200 dark:from-charcoal-900 dark:via-forest-900 dark:to-charcoal-800"></div>
    <div class="relative z-10 max-w-7xl mx-auto px-6 lg:px-8 py-32 w-full">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-8 items-center">
        <!-- Text Content -->
        <div>
          <p class="text-terracotta-500 dark:text-terracotta-400 text-sm font-medium tracking-widest uppercase mb-6">Premium Travel Planning</p>
          <h1 class="font-display text-5xl md:text-7xl lg:text-8xl text-charcoal-900 dark:text-cream-50 leading-[0.95]">
            Your trip,<br/>
            <span class="italic text-terracotta-500 dark:text-terracotta-400">handled.</span>
          </h1>
          <p class="mt-8 text-charcoal-600 dark:text-cream-200 text-lg md:text-xl max-w-xl leading-relaxed">
            The hotels you'll brag about. The reservations you couldn't get. The upgrades that just happen. We plan trips for people who've been disappointed by "luxury" before.
          </p>
          <div class="mt-10 flex flex-wrap gap-4">
            <a href={planFromHero} target="_blank" rel="noopener noreferrer" class="inline-flex items-center px-8 py-4 bg-terracotta-500 text-white font-medium text-sm uppercase tracking-wide hover:bg-terracotta-600 transition-colors rounded-full">
              Start Planning
            </a>
            <a href="/book" class="inline-flex items-center px-8 py-4 border-2 border-charcoal-900 text-charcoal-900 dark:border-cream-200 dark:text-cream-200 font-medium text-sm uppercase tracking-wide hover:bg-charcoal-900 hover:text-cream-50 dark:hover:bg-cream-200 dark:hover:text-charcoal-900 transition-colors rounded-full">
              Book a Hotel
            </a>
          </div>
          <a href="/about" class="btn-secondary mt-6">Meet Zak</a>
        </div>

        <!-- Logo Mark -->
        <div class="hidden lg:flex items-center justify-center">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 200" class="w-96 h-96 xl:w-[28rem] xl:h-[28rem] 2xl:w-[32rem] 2xl:h-[32rem] text-charcoal-200 dark:text-forest-700 opacity-60">
            <path d="M32 72 L66 145 L100 80 L134 145 L168 72"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="7"
                  stroke-linecap="round"
                  stroke-linejoin="round"/>
            <circle cx="100" cy="52" r="7" fill="currentColor"/>
          </svg>
        </div>
      </div>
    </div>
  </section>

  <!-- Two paths -->
  <section class="py-20 lg:py-24 bg-cream-100 dark:bg-forest-900">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="grid md:grid-cols-2 gap-6">
        <div class="p-8 lg:p-12 bg-cream-50 dark:bg-forest-950 rounded-3xl shadow-md">
          <p class="text-terracotta-500 dark:text-amber-400 text-sm font-medium tracking-widest uppercase">Know the hotel</p>
          <h2 class="font-display text-4xl md:text-5xl text-charcoal-900 dark:text-cream-50 mt-4">Book it yourself.</h2>
          <p class="mt-4 text-lg leading-relaxed text-charcoal-600 dark:text-cream-200">
            Search and book with Fora perks and rates. No planning fee. New clients create a profile first.
          </p>
          <a href="/book" class="btn-primary mt-8">Book a Hotel</a>
        </div>
        <div class="p-8 lg:p-12 bg-charcoal-900 dark:bg-forest-950 rounded-3xl shadow-md border border-transparent dark:border-forest-800">
          <p class="text-terracotta-400 dark:text-amber-400 text-sm font-medium tracking-widest uppercase">Want it handled</p>
          <h2 class="font-display text-4xl md:text-5xl text-cream-50 mt-4">Plan it with me.</h2>
          <p class="mt-4 text-lg leading-relaxed text-cream-200">
            Hotels, flights, the reservation you couldn't get. Tell me where you're going.
          </p>
          <a href={planFromPaths} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center px-8 py-4 mt-8 text-sm font-medium tracking-wide uppercase border-2 border-cream-200 text-cream-50 hover:bg-cream-50 hover:text-charcoal-900 transition-colors rounded-full">
            Plan My Trip
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Philosophy -->
  <section class="py-24 lg:py-32 bg-cream-50 dark:bg-forest-950">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="max-w-3xl reveal-on-scroll">
        <p class="text-terracotta-500 dark:text-amber-400 text-sm font-medium tracking-widest uppercase mb-4">The Approach</p>
        <h2 class="font-display text-4xl md:text-5xl lg:text-6xl text-charcoal-900 dark:text-cream-50 leading-tight">
          Details are <span class="italic text-terracotta-500 dark:text-amber-400">everything.</span>
        </h2>
        <p class="mt-8 text-charcoal-600 dark:text-cream-200 text-lg leading-relaxed">
          Anyone can book a hotel room. We find the right room, at the right property, with the upgrade already waiting. The dinner reservation that's "fully booked." The experience that isn't on the website. Travel that actually delivers on the promise.
        </p>
        <a href="/services" class="btn-secondary mt-8">How It Works</a>
      </div>
    </div>
  </section>

  <!-- Destinations Preview -->
  <section class="py-24 lg:py-32 bg-cream-100 dark:bg-forest-900">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12 reveal-on-scroll">
        <div>
          <p class="text-terracotta-500 dark:text-amber-400 text-sm font-medium tracking-widest uppercase mb-4">Destinations</p>
          <h2 class="font-display text-4xl md:text-5xl text-charcoal-900 dark:text-cream-50">We know a place.</h2>
        </div>
        <a href="/destinations" class="btn-secondary">View All</a>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        <a href="/destinations" class="reveal-on-scroll group relative aspect-[4/5] overflow-hidden bg-charcoal-800 rounded-3xl shadow-lg hover:shadow-xl transition-all duration-500">
          <img src="https://images.unsplash.com/photo-1523906834658-6e24ef2386f9?w=800&q=80" alt="Venice canal" class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" loading="lazy" />
          <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent group-hover:from-black/60 transition-colors"></div>
          <div class="absolute bottom-0 left-0 right-0 p-6">
            <p class="text-cream-200 text-xs font-medium tracking-wider uppercase">Old World Charm</p>
            <h3 class="font-display text-2xl text-cream-50 mt-1">European Escapes</h3>
          </div>
        </a>
        <a href="/destinations" class="reveal-on-scroll group relative aspect-[4/5] overflow-hidden bg-charcoal-800 rounded-3xl shadow-lg hover:shadow-xl transition-all duration-500">
          <img src="https://images.unsplash.com/photo-1514282401047-d79a71a590e8?w=800&q=80" alt="Tropical beach with palm trees" class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" loading="lazy" />
          <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent group-hover:from-black/60 transition-colors"></div>
          <div class="absolute bottom-0 left-0 right-0 p-6">
            <p class="text-cream-200 text-xs font-medium tracking-wider uppercase">Sun & Sand</p>
            <h3 class="font-display text-2xl text-cream-50 mt-1">Beach & Island</h3>
          </div>
        </a>
        <a href="/destinations" class="reveal-on-scroll group relative aspect-[4/5] overflow-hidden bg-charcoal-800 rounded-3xl shadow-lg hover:shadow-xl transition-all duration-500">
          <img src="https://images.unsplash.com/photo-1540959733332-eab4deabeeaf?w=800&q=80" alt="Tokyo city skyline" class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" loading="lazy" />
          <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent group-hover:from-black/60 transition-colors"></div>
          <div class="absolute bottom-0 left-0 right-0 p-6">
            <p class="text-cream-200 text-xs font-medium tracking-wider uppercase">Culture & Energy</p>
            <h3 class="font-display text-2xl text-cream-50 mt-1">City Breaks</h3>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- Services Preview -->
  <section class="py-24 lg:py-32 bg-cream-50 dark:bg-forest-950">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="text-center mb-16 reveal-on-scroll">
        <p class="text-terracotta-500 dark:text-amber-400 text-sm font-medium tracking-widest uppercase mb-4">Services</p>
        <h2 class="font-display text-4xl md:text-5xl text-charcoal-900 dark:text-cream-50">What We Handle</h2>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        <div class="reveal-on-scroll p-8 bg-cream-100/50 dark:bg-forest-900/50 backdrop-blur-sm rounded-3xl hover:shadow-lg transition-all duration-300">
          <span class="font-display text-4xl text-terracotta-500 dark:text-amber-400">01</span>
          <h3 class="font-display text-xl text-charcoal-900 dark:text-cream-50 mt-4">Custom Itineraries</h3>
          <p class="mt-3 text-charcoal-600 dark:text-cream-300">Trips designed around how you actually want to travel, not a template with your name on it.</p>
        </div>
        <div class="reveal-on-scroll p-8 bg-cream-100/50 dark:bg-forest-900/50 backdrop-blur-sm rounded-3xl hover:shadow-lg transition-all duration-300">
          <span class="font-display text-4xl text-terracotta-500 dark:text-amber-400">02</span>
          <h3 class="font-display text-xl text-charcoal-900 dark:text-cream-50 mt-4">Hotels & Resorts</h3>
          <p class="mt-3 text-charcoal-600 dark:text-cream-300">Preferred partner rates, room upgrades, resort credits, and the perks that matter.</p>
        </div>
        <div class="reveal-on-scroll p-8 bg-cream-100/50 dark:bg-forest-900/50 backdrop-blur-sm rounded-3xl hover:shadow-lg transition-all duration-300">
          <span class="font-display text-4xl text-terracotta-500 dark:text-amber-400">03</span>
          <h3 class="font-display text-xl text-charcoal-900 dark:text-cream-50 mt-4">Reservations & Access</h3>
          <p class="mt-3 text-charcoal-600 dark:text-cream-300">Restaurant bookings, private tours, and the "how did you get that?" moments.</p>
        </div>
      </div>

      <div class="text-center mt-12 space-y-4 reveal-on-scroll">
        <a href="/services" class="btn-primary">See All Services</a>
        <p class="text-sm text-charcoal-500 dark:text-cream-300">
          Booking a hotel costs you nothing. Planning fees start at $500. <a href="/services#pricing" class="text-terracotta-500 dark:text-amber-400 hover:underline">View pricing</a>
        </p>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-24 lg:py-32 bg-charcoal-900 dark:bg-forest-950">
    <div class="max-w-4xl mx-auto px-6 lg:px-8 text-center reveal-on-scroll">
      <h2 class="font-display text-4xl md:text-5xl lg:text-6xl text-cream-50 leading-tight">
        Trips worth <span class="italic text-terracotta-400 dark:text-amber-400">taking.</span>
      </h2>
      <p class="mt-6 text-cream-200 text-lg max-w-2xl mx-auto">
        Tell me where you want to go. Or just tell me what you're in the mood for. Either way, we'll figure it out.
      </p>
      <div class="mt-10 flex flex-wrap justify-center gap-4">
        <a href={planFromClose} target="_blank" rel="noopener noreferrer" class="inline-flex items-center px-8 py-4 bg-terracotta-500 dark:bg-amber-400 text-white dark:text-forest-950 font-medium text-sm uppercase tracking-wide hover:bg-terracotta-600 dark:hover:bg-amber-300 transition-colors rounded-full">
          Plan My Trip
        </a>
        <a href="/faq" class="inline-flex items-center px-8 py-4 border-2 border-cream-200 text-cream-200 font-medium text-sm uppercase tracking-wide hover:bg-cream-200 hover:text-charcoal-900 transition-colors rounded-full">
          Questions?
        </a>
      </div>
    </div>
  </section>
</Layout>

<script>
  const observerOptions = {
    root: null,
    rootMargin: '0px',
    threshold: 0.1
  };

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('visible');
        observer.unobserve(entry.target); // Only animate once
      }
    });
  }, observerOptions);

  document.addEventListener('DOMContentLoaded', () => {
    const revealElements = document.querySelectorAll('.reveal-on-scroll');
    revealElements.forEach(el => observer.observe(el));
  });
</script>
