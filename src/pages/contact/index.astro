---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import Icon from '../../components/Icon.astro';
import FormHidden from '../../components/FormHidden.astro';
import FormSubmitRow from '../../components/FormSubmitRow.astro';
import { formAction, INTAKE_URL, PORTAL_URL, SITE, SOCIAL, PRICING, PRIVATE_CLIENT } from '../../config/site';

const field =
  'w-full rounded-card border border-sand-400 bg-white px-4 dark:bg-sand-100 py-3.5 text-[16px] font-normal text-ink placeholder:text-ink-400 focus:border-clay focus:outline-none focus:ring-2 focus:ring-clay/25';
const label = 'mb-2 block text-sm font-medium text-ink';
---

<Layout title="Contact" description="Start planning with Zak Winnick, certified Fora travel advisor. New clients begin with a short intake; existing clients sign in to the client portal.">
  <PageHero eyebrow="Let's talk" intro="Tell me where you want to go. Or just tell me what you're in the mood for. Either way, we'll figure it out.">
    Start <em>here.</em>
  </PageHero>

  <!-- Two paths -->
  <section class="pt-16 md:pt-24">
    <div class="container-site grid gap-5 md:grid-cols-2 md:gap-6">
      <div class="reveal flex flex-col gap-5 rounded-card bg-pine p-8 text-cream-100 md:p-12">
        <p class="text-[13px] font-medium uppercase tracking-eyebrow text-gold">New to Wyld Wandering</p>
        <h2 class="text-[40px] leading-tight md:text-[48px]">Plan a Trip</h2>
        <p class="max-w-md text-pine-muted">The intake takes a few minutes and sets up your traveler profile: who's traveling, where you're based, how you like to be contacted, and the hotels you already love. I'll follow up to set up a conversation about the trip.</p>
        <a href={INTAKE_URL} class="btn-primary mt-3 self-start" target="_blank" rel="noopener noreferrer">Begin the Intake <Icon name="arrow" class="h-[18px] w-[18px]" /></a>
      </div>
      <div class="reveal flex flex-col gap-5 rounded-card bg-sand-200 p-8 md:p-12">
        <p class="eyebrow">Already a client</p>
        <h2 class="text-[40px] leading-tight md:text-[48px]">Client Portal</h2>
        <p class="max-w-md text-ink-700">Sign in with the email or phone number on your profile to browse and book hotels with me, perks included.</p>
        <a href={PORTAL_URL} class="btn-dark mt-3 self-start" target="_blank" rel="noopener noreferrer"><Icon name="lock" /> Client Login</a>
      </div>
    </div>
  </section>

  <!-- Quick question -->
  <section id="question" class="scroll-mt-28 py-20 md:py-28">
    <div class="container-site grid gap-14 lg:grid-cols-12 lg:gap-20">
      <div class="reveal lg:col-span-7">
        <p class="eyebrow">Quick question</p>
        <h2 class="display-md mt-5">Not ready to plan yet? <em>Ask away.</em></h2>
        <p class="mt-5 max-w-xl text-ink-700">For questions about a destination, a hotel, or how this works. If you're ready to plan a trip, the intake above is the faster route.</p>

        <form action={formAction('contact')} method="POST" class="mt-10 flex flex-col gap-6">
          <FormHidden subject="Website Question" next="/contact/sent/" />

          <div class="grid gap-6 sm:grid-cols-2">
            <div>
              <label for="name" class={label}>Name <span class="text-clay" aria-hidden="true">*</span></label>
              <input id="name" name="Name" type="text" required autocomplete="name" class={field} />
            </div>
            <div>
              <label for="email" class={label}>Email <span class="text-clay" aria-hidden="true">*</span></label>
              <input id="email" name="email" type="email" required autocomplete="email" class={field} />
            </div>
          </div>
          <div>
            <label for="message" class={label}>Your question <span class="text-clay" aria-hidden="true">*</span></label>
            <textarea id="message" name="Question" required rows="6" class={field} placeholder="Ask about a destination, a hotel, or how working together works."></textarea>
          </div>
          <FormSubmitRow label="Send Question" variant="dark" />
        </form>
      </div>

      <aside class="reveal flex flex-col gap-5 lg:col-span-5">
        <div class="flex flex-col gap-5 rounded-card border border-sand-300 p-8">
          <div class="flex items-start gap-4">
            <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-sand-200 text-clay"><Icon name="mail" class="h-5 w-5" /></span>
            <div>
              <p class="text-sm font-medium text-ink">Email Direct</p>
              <a href={`mailto:${SITE.email}`} class="link-accent">{SITE.email}</a>
            </div>
          </div>
          <div class="flex items-start gap-4">
            <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-sand-200 text-clay"><Icon name="clock" class="h-5 w-5" /></span>
            <div>
              <p class="text-sm font-medium text-ink">Response Time</p>
              <p class="text-ink-700">I typically respond within 1 to 2 business days. If something is urgent, say so and I'll prioritize it.</p>
            </div>
          </div>
          <div class="flex flex-wrap gap-x-6 gap-y-2 border-t border-sand-300 pt-5 text-[15px]">
            <a href={SOCIAL.x} class="link-accent" target="_blank" rel="noopener noreferrer">X {SOCIAL.xHandle}</a>
            <a href={SOCIAL.instagram} class="link-accent" target="_blank" rel="noopener noreferrer">Instagram {SOCIAL.instagramHandle}</a>
          </div>
        </div>

        <div class="flex flex-col gap-4 rounded-card bg-sand-200 p-8">
          <h3 class="text-[28px] leading-tight">Planning Fees</h3>
          <ul class="flex flex-col gap-2 text-ink-700">
            {[...PRICING, PRIVATE_CLIENT].map((tier) => <li class="flex items-baseline justify-between gap-4 border-b border-sand-300 pb-2 last:border-0 last:pb-0"><span>{tier.name}</span><strong class="text-right font-medium text-ink">{tier.price}</strong></li>)}
          </ul>
          <a href="/services#pricing" class="link-accent self-start text-[15px]">Full Pricing Details</a>
        </div>

        <div class="flex flex-col gap-3 rounded-card border border-sand-300 p-8">
          <h3 class="text-[28px] leading-tight">Have Questions First?</h3>
          <p class="text-ink-700">How planning works, what an advisor does, and what to expect.</p>
          <a href="/faq" class="link-accent self-start text-[15px]">Browse the FAQ</a>
        </div>
      </aside>
    </div>
  </section>
</Layout>
