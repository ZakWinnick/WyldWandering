---
import Layout from '../layouts/Layout.astro';
import { intakeLink, portalLink } from '../lib/fora';

const bookYourself = portalLink('book-page');
const createProfile = intakeLink('book-page-new');
const planTrip = intakeLink('book-page-plan');

const notes = [
  {
    number: '01',
    title: 'No planning fee',
    description:
      'A hotel you book through the portal costs you nothing extra. You pay the hotel. I earn a commission. The perks are the point.',
  },
  {
    number: '02',
    title: 'Hotels',
    description:
      'The portal books hotels. Flights, restaurants, and a full itinerary are planning work, and that has a fee.',
  },
  {
    number: '03',
    title: 'Not every hotel is listed',
    description:
      "If you don't see the one you want, ask. I'll book it, or I'll tell you if it isn't worth booking.",
  },
];
---

<Layout
  title="Book a Hotel"
  description="Search and book hotels yourself with Fora perks and rates. No planning fee. New clients create a profile first. Wyld Wandering is an independent Fora advisor."
>
  <section class="pt-28 pb-20 md:pt-36 md:pb-28 lg:pt-40 lg:pb-32 px-6 md:px-12 bg-forest-950">
    <div class="max-w-7xl mx-auto">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-20 items-end">
        <div>
          <span class="inline-block text-sm uppercase tracking-[0.2em] font-medium mb-6 text-amber-400">
            Book a Hotel
          </span>
          <h1 class="text-5xl md:text-6xl lg:text-7xl font-display leading-[1.1] text-cream-50">
            Book it
            <br />
            <em class="font-normal">yourself.</em>
          </h1>
        </div>
        <div class="lg:pb-4">
          <p class="text-xl md:text-2xl font-display leading-relaxed text-cream-200">
            If you already know where you want to stay, you don't need me in the middle of the search. Existing clients can book the hotel themselves, with the Fora perks and rates I use.
          </p>
        </div>
      </div>
      <div class="mt-16 lg:mt-24 h-px w-full bg-forest-800"></div>
    </div>
  </section>

  <section class="py-20 md:py-28 px-6 md:px-12 bg-cream-100 dark:bg-forest-900">
    <div class="max-w-7xl mx-auto grid lg:grid-cols-2 gap-6">
      <article class="p-8 lg:p-12 bg-cream-50 dark:bg-forest-950 rounded-3xl shadow-md flex flex-col">
        <p class="text-sm uppercase tracking-[0.2em] font-medium text-terracotta-500 dark:text-amber-400">
          Existing clients
        </p>
        <h2 class="font-display text-4xl md:text-5xl text-charcoal-900 dark:text-cream-50 mt-4">
          Search and book.
        </h2>
        <p class="mt-6 text-lg leading-relaxed text-charcoal-600 dark:text-cream-200 flex-1">
          Sign in with the email or phone on your profile. Compare hotels, rates, and the perks that come with booking through an advisor. It costs you nothing.
        </p>
        <a
          href={bookYourself}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-10 inline-flex items-center justify-center px-8 py-4 text-sm uppercase tracking-wider font-medium bg-terracotta-500 text-white hover:bg-terracotta-600 dark:bg-amber-400 dark:text-forest-950 dark:hover:bg-amber-500 transition-colors duration-300 rounded-full"
        >
          Book it yourself
        </a>
      </article>

      <article class="p-8 lg:p-12 bg-charcoal-900 dark:bg-forest-950 rounded-3xl shadow-md flex flex-col border border-transparent dark:border-forest-800">
        <p class="text-sm uppercase tracking-[0.2em] font-medium text-terracotta-400 dark:text-amber-400">
          New clients
        </p>
        <h2 class="font-display text-4xl md:text-5xl text-cream-50 mt-4">
          Create your profile.
        </h2>
        <p class="mt-6 text-lg leading-relaxed text-cream-200 flex-1">
          The portal needs a client profile before you can book. The form takes a few minutes. Once it's in, you can search and book hotels yourself, with the same perks.
        </p>
        <a
          href={createProfile}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-10 inline-flex items-center justify-center px-8 py-4 text-sm uppercase tracking-wider font-medium border border-cream-200 text-cream-50 hover:bg-cream-50 hover:text-charcoal-900 transition-colors duration-300 rounded-full"
        >
          Create your profile
        </a>
      </article>
    </div>
  </section>

  <section class="py-20 md:py-28 px-6 md:px-12 bg-cream-50 dark:bg-forest-950">
    <div class="max-w-7xl mx-auto">
      <div class="max-w-2xl mb-12">
        <p class="text-sm uppercase tracking-[0.2em] font-medium text-terracotta-500 dark:text-amber-400 mb-4">
          Worth knowing
        </p>
        <h2 class="font-display text-4xl md:text-5xl text-charcoal-900 dark:text-cream-50">
          A hotel, handled differently.
        </h2>
      </div>
      <div class="grid md:grid-cols-3 gap-6">
        {notes.map((note) => (
          <article class="p-8 bg-cream-100/50 dark:bg-forest-900/50 rounded-3xl">
            <span class="font-display text-4xl text-terracotta-500 dark:text-amber-400">{note.number}</span>
            <h3 class="font-display text-2xl text-charcoal-900 dark:text-cream-50 mt-4">{note.title}</h3>
            <p class="mt-3 leading-relaxed text-charcoal-600 dark:text-cream-200">{note.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="py-20 md:py-28 px-6 md:px-12 bg-cream-100 dark:bg-forest-900">
    <div class="max-w-7xl mx-auto">
      <div class="relative overflow-hidden p-12 md:p-16 bg-cream-50 dark:bg-forest-950 rounded-3xl shadow-xl">
        <div class="relative z-10 max-w-3xl">
          <h2 class="text-4xl md:text-5xl font-display text-charcoal-900 dark:text-cream-50">
            Want the whole trip
            <br />
            <em class="font-normal">handled?</em>
          </h2>
          <p class="text-xl mt-6 mb-10 max-w-xl text-charcoal-600 dark:text-cream-200">
            Hotels, flights, the reservation that's "fully booked." That's planning, and it starts with the same profile.
          </p>
          <div class="flex flex-col sm:flex-row gap-4">
            <a
              href={planTrip}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center px-8 py-4 text-sm uppercase tracking-wider font-medium bg-terracotta-500 text-white hover:bg-terracotta-600 dark:bg-amber-400 dark:text-forest-950 dark:hover:bg-amber-500 transition-colors duration-300 rounded-full"
            >
              Plan my trip
            </a>
            <a
              href="/services#pricing"
              class="inline-flex items-center justify-center px-8 py-4 text-sm uppercase tracking-wider font-medium border border-charcoal-900 dark:border-cream-50 text-charcoal-900 dark:text-cream-50 hover:bg-charcoal-900 hover:text-white dark:hover:bg-cream-50 dark:hover:text-forest-950 transition-colors duration-300 rounded-full"
            >
              See planning fees
            </a>
          </div>
          <p class="mt-8 text-charcoal-600 dark:text-cream-200">
            A question that isn't a booking?
            <a href="/contact" class="text-terracotta-500 dark:text-amber-400 hover:underline">Write me</a>.
          </p>
        </div>
        <div class="absolute -top-20 -right-20 w-80 h-80 rounded-full bg-terracotta-500/10 dark:bg-amber-400/10"></div>
      </div>
    </div>
  </section>
</Layout>
