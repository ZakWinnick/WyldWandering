---
import Layout from '../../../layouts/Layout.astro';
import PageHero from '../../../components/PageHero.astro';
import { SITE } from '../../../config/site';
---

<Layout title="Application Received" noindex>
  <PageHero eyebrow="Annual Retainer" intro="Thanks for applying. I read every application myself and will reply within two business days to set up a call.">
    Application <em>received.</em>
  </PageHero>
  <section class="py-16 md:py-20">
    <div class="container-site flex flex-wrap items-center gap-6">
      <a href="/" class="btn-dark">Back to Home</a>
      <a href={`mailto:${SITE.email}`} class="link-accent">{SITE.email}</a>
    </div>
  </section>
</Layout>
