---
import Layout from '../../../layouts/Layout.astro';
import PageHero from '../../../components/PageHero.astro';
import Icon from '../../../components/Icon.astro';
import { FORM_EMAIL, SITE, RETAINER } from '../../../config/site';

// Static site: FormSubmit emails each application to SITE.email. Field names are
// written as readable labels because they become the rows of that email.
const field =
  'w-full rounded-card border border-sand-400 bg-white px-4 py-3.5 text-[16px] font-normal text-ink placeholder:text-ink-400 focus:border-clay focus:outline-none focus:ring-2 focus:ring-clay/25 dark:bg-sand-100';
const label = 'mb-2 block text-sm font-medium text-ink';
const hint = 'mt-1.5 text-sm text-ink-600';

const tripTypes = ['Leisure', 'Business', 'Family', 'Special occasions'];
const tripsPerYear = ['2 to 3', '4 to 6', '7 to 10', 'More than 10'];
const spend = ['Under $5,000', '$5,000 to $10,000', '$10,000 to $25,000', '$25,000 to $50,000', 'Over $50,000'];
---

<Layout title="Apply for the Retainer" description="Apply for the Wyld Wandering annual retainer: up to six full itineraries a year, same-business-day response, and 50% off everything else.">
  <PageHero eyebrow={RETAINER.name} intro="The retainer is for people who travel often and want one person handling all of it. Tell me how you travel, and I'll be in touch within two business days.">
    Apply for the <em>retainer.</em>
  </PageHero>

  <section class="py-16 md:py-24">
    <div class="container-site grid gap-14 lg:grid-cols-12 lg:gap-20">
      <form action={`https://formsubmit.co/${FORM_EMAIL}`} method="POST" class="flex flex-col gap-10 lg:col-span-7">
        <input type="hidden" name="_subject" value="Retainer Application" />
        <input type="hidden" name="_template" value="table" />
        <input type="hidden" name="_next" value={`${SITE.url}/retainer/apply/received/`} />
        <input type="text" name="_honey" class="hidden" tabindex="-1" autocomplete="off" aria-hidden="true" />

        <fieldset class="flex flex-col gap-6">
          <legend class="sr-only">About You</legend>
          <p aria-hidden="true" class="font-display text-[30px] font-medium leading-tight">About You</p>
          <div class="grid gap-6 sm:grid-cols-2">
            <div>
              <label for="name" class={label}>Name <span class="text-clay" aria-hidden="true">*</span></label>
              <input id="name" name="Name" type="text" required autocomplete="name" class={field} />
            </div>
            <div>
              <label for="email" class={label}>Email <span class="text-clay" aria-hidden="true">*</span></label>
              <input id="email" name="email" type="email" required autocomplete="email" class={field} />
            </div>
            <div>
              <label for="phone" class={label}>Phone</label>
              <input id="phone" name="Phone" type="tel" autocomplete="tel" class={field} />
            </div>
            <div>
              <label for="based" class={label}>Where You're Based <span class="text-clay" aria-hidden="true">*</span></label>
              <input id="based" name="Based in" type="text" required autocomplete="address-level2" placeholder="City, state or country" class={field} />
            </div>
          </div>
        </fieldset>

        <fieldset class="flex flex-col gap-6 border-t border-sand-300 pt-10">
          <legend class="sr-only">How You Travel</legend>
          <p aria-hidden="true" class="font-display text-[30px] font-medium leading-tight">How You Travel</p>
          <div class="grid gap-6 sm:grid-cols-2">
            <div>
              <label for="trips" class={label}>Trips a Year <span class="text-clay" aria-hidden="true">*</span></label>
              <select id="trips" name="Trips a year" required class={field}>
                <option value="" disabled selected>Roughly how many?</option>
                {tripsPerYear.map((t) => <option value={t}>{t}</option>)}
              </select>
            </div>
            <div>
              <label for="spend" class={label}>Typical Spend per Trip</label>
              <select id="spend" name="Typical spend per trip" class={field}>
                <option value="" selected>Choose a range</option>
                {spend.map((t) => <option value={t}>{t}</option>)}
              </select>
            </div>
          </div>
          <div>
            <p id="types-label" class={label}>Kinds of Trips</p>
            <div role="group" aria-labelledby="types-label" class="flex flex-wrap gap-3">
              {
                tripTypes.map((t) => (
                  <label class="inline-flex min-h-[44px] cursor-pointer items-center gap-2.5 rounded-full border border-sand-400 px-4 text-[15px] font-normal text-ink has-[:checked]:border-clay has-[:checked]:bg-clay/10">
                    <input type="checkbox" name={`Trip type: ${t}`} value="Yes" class="h-4 w-4 accent-clay" />
                    {t}
                  </label>
                ))
              }
            </div>
          </div>
          <div>
            <label for="who" class={label}>Who Usually Travels with You</label>
            <input id="who" name="Travels with" type="text" placeholder="Partner, kids, friends, colleagues, solo" class={field} />
          </div>
          <div>
            <label for="loyalty" class={label}>Hotels or Brands You're Loyal To</label>
            <input id="loyalty" name="Hotel loyalty" type="text" placeholder="Four Seasons, Aman, a favorite independent" class={field} />
          </div>
        </fieldset>

        <fieldset class="flex flex-col gap-6 border-t border-sand-300 pt-10">
          <legend class="sr-only">The Retainer</legend>
          <p aria-hidden="true" class="font-display text-[30px] font-medium leading-tight">The Retainer</p>
          <div>
            <label for="want" class={label}>What You Want from the Retainer <span class="text-clay" aria-hidden="true">*</span></label>
            <textarea id="want" name="Wants from the retainer" required rows="5" class={field} placeholder="The trips on your calendar this year, what's frustrated you about planning before, what would make this worth it."></textarea>
          </div>
          <div>
            <label for="heard" class={label}>How You Heard About Wyld Wandering</label>
            <input id="heard" name="Heard about us" type="text" class={field} />
          </div>
          <label class="flex cursor-pointer items-start gap-3 rounded-card bg-sand-200 p-5 text-[15px] font-normal text-ink-700">
            <input type="checkbox" name="Understands terms" value="Yes" required class="mt-1 h-4 w-4 shrink-0 accent-clay" />
            <span>I understand the retainer is {RETAINER.amount} a year, billed annually or $1,350 quarterly, and that full terms are shared on approval. <span class="text-clay" aria-hidden="true">*</span></span>
          </label>
        </fieldset>

        <div class="flex flex-col gap-3">
          <button type="submit" class="btn-primary self-start">Send Application <Icon name="arrow" class="h-[18px] w-[18px]" /></button>
          <p class="text-sm text-ink-600"><span class="text-clay" aria-hidden="true">*</span> Required. Your answers come to me by email.</p>
        </div>
      </form>

      <aside class="flex flex-col gap-5 lg:col-span-5">
        <div class="flex flex-col gap-5 rounded-card bg-pine p-8 text-cream-100 md:p-10 lg:sticky lg:top-28">
          <p class="text-[13px] font-medium uppercase tracking-eyebrow text-gold">{RETAINER.name}</p>
          <p class="font-display text-[52px] font-medium leading-none">{RETAINER.amount}<span class="font-sans text-lg font-light text-pine-muted"> per year</span></p>
          <p class="text-pine-muted">{RETAINER.billing}</p>
          <ul class="flex flex-col">
            {RETAINER.includes.map((item) => <li class="border-t border-cream-100/15 py-3.5 text-cream-100">{item}</li>)}
          </ul>
          <p class="border-t border-cream-100/15 pt-4 text-[15px] text-pine-muted">{RETAINER.invite}</p>
          <a href="/services#retainer" class="self-start text-[15px] font-medium text-gold underline-offset-4 hover:text-gold-soft hover:underline">Retainer Details</a>
        </div>
      </aside>
    </div>
  </section>
</Layout>
