---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import StartHere from '../components/StartHere.astro';
import Icon from '../components/Icon.astro';
import { INTAKE_URL } from '../config/site';

import venice from '../assets/images/venice.jpg';
import beach from '../assets/images/beach.jpg';
import tokyo from '../assets/images/tokyo.jpg';
import elephant from '../assets/images/elephant.jpg';
import wellness from '../assets/images/wellness.jpg';
import wine from '../assets/images/wine.jpg';
import positano from '../assets/images/positano.jpg';
import maldives from '../assets/images/maldives.jpg';
import kyoto from '../assets/images/kyoto.jpg';
import savanna from '../assets/images/savanna.jpg';

const categories = [
  {
    title: 'European escapes',
    body: 'Historic cities, coastal villages, and countryside retreats. From Tuscan villas to Parisian apartments to Santorini sunsets.',
    highlights: ['Italy', 'France', 'Spain', 'Greece'],
    img: venice,
    alt: 'Gondola on a Venice canal beneath the Rialto Bridge',
  },
  {
    title: 'Beach and island',
    body: 'Crystal water, white sand, and properties worth staying at. Caribbean hideaways, Maldives overwater villas, and Mediterranean coastlines.',
    highlights: ['Maldives', 'Caribbean', 'Bali', 'Thailand'],
    img: beach,
    alt: 'Aerial view of overwater villas on a turquoise lagoon',
  },
  {
    title: 'City breaks',
    body: 'The best neighborhoods, the right hotels, the reservations worth having. New York to Tokyo, London to Buenos Aires.',
    highlights: ['New York', 'London', 'Tokyo', 'Paris'],
    img: tokyo,
    alt: 'Neon-lit street crossing in Tokyo',
  },
  {
    title: 'Safari and wildlife',
    body: 'Luxury safari lodges, private game reserves, and once-in-a-lifetime wildlife encounters. Africa, South America, and beyond.',
    highlights: ['Kenya', 'Tanzania', 'Botswana', 'South Africa'],
    img: elephant,
    alt: 'Safari vehicle in tall grass at sunset',
  },
  {
    title: 'Luxury wellness',
    body: 'World-class spas, wellness retreats, and restorative escapes. Places that actually leave you feeling better than when you arrived.',
    highlights: ['Aman', 'Six Senses', 'COMO', 'Canyon Ranch'],
    img: wellness,
    alt: 'Oil massage treatment at a spa',
  },
  {
    title: 'Wine and culinary',
    body: 'Vineyard tours, Michelin-starred dining, and food experiences that become the trip. Napa to Burgundy to Rioja.',
    highlights: ['Napa Valley', 'Bordeaux', 'Tuscany', 'Mendoza'],
    img: wine,
    alt: 'Glass of red wine on a ledge above vineyard rows',
  },
];

const trips = [
  {
    name: 'Amalfi Coast and Rome',
    duration: '10 days',
    category: 'European escapes',
    body: 'Cliffside hotels overlooking the Mediterranean, private transfers, and reservations at restaurants that matter.',
    img: positano,
    alt: 'Pastel houses stacked on the cliffs of Positano',
  },
  {
    name: 'Maldives honeymoon',
    duration: '7 days',
    category: 'Beach and island',
    body: 'Overwater villas, private beach dinners, spa treatments, and the kind of seclusion that honeymoons deserve.',
    img: maldives,
    alt: 'Overwater villas above turquoise water',
  },
  {
    name: 'Tokyo and Kyoto',
    duration: '12 days',
    category: 'City breaks',
    body: 'From modern Tokyo hotels to traditional Kyoto ryokans. Omakase dinners, temple visits, and the experiences not in the guidebooks.',
    img: kyoto,
    alt: 'Lantern-lit lane leading to a pagoda in Kyoto at dusk',
  },
  {
    name: 'Kenya safari',
    duration: '8 days',
    category: 'Safari and wildlife',
    body: 'Luxury tented camps, private game drives, and the Great Migration. Wildlife encounters that change how you see the world.',
    img: savanna,
    alt: 'Acacia tree on the savanna at sunset',
  },
];
---

<Layout title="Destinations" description="Curated destinations for discerning travelers. European escapes, beach retreats, city breaks, safari, wellness, and wine country. Premium travel planning by Wyld Wandering.">
  <PageHero eyebrow="Destinations" intro="European coastlines, tropical islands, world-class cities, and everything in between. Tell me what you're in the mood for. I'll find the places worth going.">
    We know<br class="hidden sm:block" /> <em>a place.</em>
  </PageHero>

  <!-- Categories -->
  <section class="py-24 md:py-32">
    <div class="container-site flex flex-col gap-14">
      <div class="reveal flex max-w-3xl flex-col gap-5">
        <p class="eyebrow">Explore by type</p>
        <h2 class="display-lg">Where do you <em>want to go?</em></h2>
      </div>
      <div class="grid gap-x-6 gap-y-14 md:grid-cols-2 lg:grid-cols-3">
        {
          categories.map((c) => (
            <article class="reveal flex flex-col gap-5">
              <Image src={c.img} alt={c.alt} widths={[500, 800, 1100]} sizes="(min-width: 1024px) 31vw, (min-width: 768px) 48vw, 100vw" class="aspect-[4/3] w-full rounded-card object-cover" />
              <h3 class="text-[32px] leading-tight">{c.title}</h3>
              <p class="text-ink-600">{c.body}</p>
              <ul class="flex flex-wrap gap-2" aria-label={`${c.title} highlights`}>
                {c.highlights.map((h) => (
                  <li class="rounded-full border border-sand-300 px-3.5 py-1 text-[13px] font-normal text-ink-700">{h}</li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Featured trips -->
  <section class="bg-sand-200 py-24 md:py-28">
    <div class="container-site flex flex-col gap-14">
      <div class="reveal flex flex-col justify-between gap-8 lg:flex-row lg:items-end">
        <div class="flex flex-col gap-5">
          <p class="eyebrow">Signature experiences</p>
          <h2 class="display-lg">Featured <em>trips.</em></h2>
        </div>
        <p class="max-w-md text-ink-700">A few examples of what's possible. Each itinerary is fully customizable. These are starting points, not packages.</p>
      </div>
      <div class="grid gap-6 md:grid-cols-2">
        {
          trips.map((t) => (
            <article class="reveal flex flex-col overflow-hidden rounded-card bg-sand-50">
              <div class="relative">
                <Image src={t.img} alt={t.alt} widths={[600, 900, 1300]} sizes="(min-width: 768px) 48vw, 100vw" class="aspect-[16/10] w-full object-cover" />
                <span class="absolute left-5 top-5 rounded-full bg-sand-50/95 px-4 py-1.5 text-[13px] font-medium text-ink">{t.duration}</span>
              </div>
              <div class="flex flex-col gap-3 p-8 md:p-10">
                <span class="text-xs font-medium uppercase tracking-[0.2em] text-clay">{t.category}</span>
                <h3 class="text-[34px] leading-tight">{t.name}</h3>
                <p class="text-ink-600">{t.body}</p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Somewhere else -->
  <section class="py-24 md:py-28">
    <div class="container-site reveal flex flex-col items-start gap-6 lg:flex-row lg:items-end lg:justify-between">
      <div class="flex max-w-2xl flex-col gap-5">
        <p class="eyebrow">Somewhere else?</p>
        <h2 class="display-md">Don't see what you're <em>looking for?</em></h2>
        <p class="text-ink-700">These are just examples. Tell me where you want to go, or just what you're in the mood for. We'll figure it out together. No commitment, just a conversation.</p>
      </div>
      <a href={INTAKE_URL} class="btn-primary shrink-0" target="_blank" rel="noopener noreferrer">Start planning <Icon name="arrow" class="h-[18px] w-[18px]" /></a>
    </div>
  </section>

  <StartHere />
</Layout>
