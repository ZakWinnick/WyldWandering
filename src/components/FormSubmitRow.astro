---
// Turnstile check, status message and submit button for site forms. With the
// Worker live, submits by fetch so a failed send keeps what the visitor typed;
// without JS the form still posts and the Worker redirects.
import Icon from './Icon.astro';
import { FORMS_LIVE, TURNSTILE_SITE_KEY, SITE } from '../config/site';
interface Props {
  label: string;
  variant?: 'primary' | 'dark';
  note?: string;
}
const { label, variant = 'primary', note } = Astro.props;
---

{FORMS_LIVE && <div class="cf-turnstile" data-sitekey={TURNSTILE_SITE_KEY} data-appearance="interaction-only" data-theme="auto"></div>}
<p id="form-status" role="alert" class="hidden scroll-mt-32 rounded-card border border-clay/40 bg-clay/10 px-5 py-4 text-[15px] text-ink" data-email={SITE.email} data-live={FORMS_LIVE ? "true" : undefined}></p>
<div class="flex flex-col gap-3">
  <button type="submit" class:list={[variant === 'primary' ? 'btn-primary' : 'btn-dark', 'self-start disabled:opacity-60']}>
    <span data-label>{label}</span>
    <Icon name="arrow" class="h-[18px] w-[18px]" />
  </button>
  {note && <p class="text-sm text-ink-600">{note}</p>}
</div>

{FORMS_LIVE && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}

<script>
  const messages: Record<string, string> = {
    verify: "We couldn't confirm you're not a bot. Please try again.",
    rate: 'Too many tries in a short time. Please wait a minute and try again.',
    invalid: 'Some required details are missing. Please check the form and try again.',
    send: "Your message didn't go through on our end. Please try again, or email ",
  };
  const status = document.getElementById('form-status');
  const show = (code: string) => {
    if (!status) return;
    const email = status.dataset.email || '';
    status.textContent = (messages[code] || messages.send) + (code === 'send' || !messages[code] ? `${email}.` : '');
    status.classList.remove('hidden');
    status.scrollIntoView({ block: 'center', behavior: 'smooth' });
  };

  const err = new URLSearchParams(location.search).get('error');
  if (err) show(err);

  const form = status?.closest('form');
  if (form && status?.dataset.live === 'true') {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const button = form.querySelector<HTMLButtonElement>('button[type=submit]');
      const label = button?.querySelector<HTMLElement>('[data-label]');
      const original = label?.textContent;
      if (button) button.disabled = true;
      if (label) label.textContent = 'Sending...';
      status?.classList.add('hidden');
      try {
        const res = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
        const out = await res.json();
        if (out.ok) {
          location.href = out.redirect;
          return;
        }
        show(out.error);
      } catch {
        show('send');
      }
      (window as unknown as { turnstile?: { reset: () => void } }).turnstile?.reset();
      if (button) button.disabled = false;
      if (label && original) label.textContent = original;
    });
  }
</script>
