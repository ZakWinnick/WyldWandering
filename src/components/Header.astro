---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { NAV_LINKS, INTAKE_URL, PORTAL_URL, SOCIAL, SITE } from '../config/site';

interface Props {
  /** Transparent header over a photo hero; turns solid on scroll. */
  overlay?: boolean;
}

const { overlay = false } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header
  id="site-header"
  data-overlay={overlay ? 'true' : 'false'}
  data-solid={overlay ? 'false' : 'true'}
  class:list={[
    'group z-50 w-full transition-[background-color,color,box-shadow] duration-300',
    overlay ? 'fixed left-0 right-0 top-0' : 'sticky top-0',
    'text-cream-50 data-[solid=true]:bg-sand-50/95 data-[solid=true]:text-ink data-[solid=true]:shadow-[0_1px_0_rgb(var(--c-sand-300))] data-[solid=true]:backdrop-blur-md',
  ]}
>
  <div class="container-site flex items-center justify-between gap-6 py-4 group-data-[solid=false]:py-6 transition-[padding] duration-300">
    <a href="/" aria-label={`${SITE.name} home`} class="block shrink-0 text-current hover:text-current">
      <Logo class="h-12 w-auto md:h-14" />
    </a>

    <nav aria-label="Main" class="hidden items-center gap-9 text-[15px] font-normal lg:flex">
      {
        NAV_LINKS.map((link) => (
          <a
            href={link.href}
            aria-current={isCurrent(link.href) ? 'page' : undefined}
            class="text-current opacity-90 transition-opacity hover:text-current hover:opacity-100 aria-[current=page]:opacity-100 aria-[current=page]:underline aria-[current=page]:decoration-1 aria-[current=page]:underline-offset-8"
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2 sm:gap-5">
      <a href={PORTAL_URL} class="hidden min-h-[44px] items-center gap-2 text-[15px] font-normal text-current hover:text-current hover:opacity-80 sm:inline-flex">
        <Icon name="lock" />
        Client Login
      </a>
      <a
        href={INTAKE_URL}
        class="hidden min-h-[44px] items-center rounded-full px-5 text-sm font-medium tracking-[0.04em] transition-colors sm:inline-flex bg-clay text-white hover:bg-clay-dark hover:text-white dark:text-night dark:hover:text-night group-data-[solid=false]:bg-cream-50 group-data-[solid=false]:text-night group-data-[solid=false]:hover:bg-white"
      >
        Start Planning
      </a>
      <button
        id="menu-open"
        type="button"
        class="-mr-2 inline-flex h-11 w-11 items-center justify-center text-current lg:hidden"
        aria-label="Open menu"
        aria-controls="mobile-menu"
        aria-expanded="false"
      >
        <Icon name="menu" class="h-6 w-6" />
      </button>
    </div>
  </div>
</header>

<div id="mobile-menu" class="fixed inset-0 z-[60] hidden flex-col overflow-y-auto bg-pine text-cream-100" role="dialog" aria-modal="true" aria-label="Menu">
  <div class="container-site flex items-center justify-between py-4">
    <a href="/" aria-label={`${SITE.name} home`} class="text-cream-100 hover:text-cream-100">
      <Logo class="h-12 w-auto" />
    </a>
    <button id="menu-close" type="button" class="-mr-2 inline-flex h-11 w-11 items-center justify-center text-cream-100" aria-label="Close menu">
      <Icon name="close" class="h-6 w-6" />
    </button>
  </div>
  <nav aria-label="Mobile" class="container-site flex flex-1 flex-col justify-center gap-2 py-10">
    <a href="/" class="font-display text-[44px] leading-tight text-cream-100 hover:text-gold">Home</a>
    {
      NAV_LINKS.map((link) => (
        <a href={link.href} class="font-display text-[44px] leading-tight text-cream-100 hover:text-gold">
          {link.label}
        </a>
      ))
    }
    <a href="/contact" class="font-display text-[44px] leading-tight text-cream-100 hover:text-gold">Contact</a>
  </nav>
  <div class="container-site flex flex-col gap-3 pb-10">
    <a href={INTAKE_URL} class="btn-primary w-full">Start Planning <Icon name="arrow" /></a>
    <a href={PORTAL_URL} class="btn-outline-light w-full"><Icon name="lock" /> Client Login</a>
    <div class="mt-6 flex gap-6 text-sm text-pine-muted">
      <a href={SOCIAL.instagram} class="text-pine-muted hover:text-gold">Instagram</a>
      <a href={SOCIAL.x} class="text-pine-muted hover:text-gold">X {SOCIAL.xHandle}</a>
      <a href={`mailto:${SITE.email}`} class="text-pine-muted hover:text-gold">{SITE.email}</a>
    </div>
  </div>
</div>

<script>
  const header = document.getElementById('site-header');
  const menu = document.getElementById('mobile-menu');
  const openBtn = document.getElementById('menu-open');
  const closeBtn = document.getElementById('menu-close');

  if (header && header.dataset.overlay === 'true') {
    const update = () => {
      header.dataset.solid = window.scrollY > 40 ? 'true' : 'false';
    };
    update();
    window.addEventListener('scroll', update, { passive: true });
  }

  const setMenu = (open: boolean) => {
    if (!menu || !openBtn) return;
    menu.classList.toggle('hidden', !open);
    menu.classList.toggle('flex', open);
    openBtn.setAttribute('aria-expanded', String(open));
    document.body.style.overflow = open ? 'hidden' : '';
    if (open) closeBtn?.focus();
    else openBtn.focus();
  };

  openBtn?.addEventListener('click', () => setMenu(true));
  closeBtn?.addEventListener('click', () => setMenu(false));
  menu?.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setMenu(false);
  });
  menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setMenu(false)));
</script>
