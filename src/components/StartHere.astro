---
// Closing band used at the bottom of every page: new clients go to the trip
// inquiry form; frequent travelers to the Private Client application.
import Icon from './Icon.astro';
import { START_URL, PRIVATE_CLIENT_APPLY_URL, SITE } from '../config/site';

interface Props {
  heading?: string;
}
const { heading } = Astro.props;
---

<section class="bg-pine py-24 text-cream-100 md:py-32" aria-labelledby="start-here-heading">
  <div class="container-site flex flex-col gap-12 md:gap-14">
    <h2 id="start-here-heading" class="reveal font-display font-medium leading-none" style="font-size: clamp(2.75rem, 5.4vw, 5rem)">
      {heading ? heading : <Fragment>Trips worth <em class="font-normal italic text-gold">taking.</em> Start here.</Fragment>}
    </h2>

    <div class="grid gap-5 md:grid-cols-2 md:gap-6">
      <div class="reveal flex flex-col gap-4 rounded-card border border-cream-100/20 p-8 md:p-11">
        <p class="text-[13px] font-medium uppercase tracking-eyebrow text-gold">Plan a trip</p>
        <h3 class="text-[36px]">Start Planning</h3>
        <p class="max-w-md text-pine-muted">Tell me where you're thinking of going, who's coming and what would make it worth it. I'll reply within two business days.</p>
        <a href={START_URL} target="_blank" rel="noopener noreferrer" class="btn-primary mt-3 self-start">Share Your Trip <Icon name="arrow" class="h-[18px] w-[18px]" /></a>
      </div>

      <div class="reveal flex flex-col gap-4 rounded-card bg-sand-100 p-8 text-ink md:p-11">
        <p class="text-[13px] font-medium uppercase tracking-eyebrow text-clay-dark">For frequent travelers</p>
        <h3 class="text-[36px]">Private Client</h3>
        <p class="max-w-md text-ink-700">One person handling every trip, all year: up to six full itineraries, same-business-day response, and 50% off everything else.</p>
        <a href={PRIVATE_CLIENT_APPLY_URL} class="btn-dark mt-3 self-start">Become a Private Client</a>
      </div>
    </div>

    <p class="text-[15px] text-cream-500">
      Just have a quick question? <a href="/contact#question" class="text-gold underline-offset-4 hover:text-gold-soft hover:underline">Send a Note</a> or email <a href={`mailto:${SITE.email}`} class="text-gold underline-offset-4 hover:text-gold-soft hover:underline">{SITE.email}</a>.
    </p>
  </div>
</section>
