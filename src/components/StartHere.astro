---
// Closing band used at the bottom of every page: new clients go to the Fora intake,
// existing clients go to the Fora client portal.
import Icon from './Icon.astro';
import { INTAKE_URL, PORTAL_URL, SITE } from '../config/site';

interface Props {
  heading?: string;
}
const { heading } = Astro.props;
---

<section class="bg-pine py-24 text-cream-100 md:py-32" aria-labelledby="start-here-heading">
  <div class="container-site flex flex-col gap-12 md:gap-14">
    <h2 id="start-here-heading" class="reveal font-display font-medium leading-none" style="font-size: clamp(2.75rem, 5.4vw, 5rem)">
      {heading ? heading : <Fragment>Trips worth <em class="font-normal italic text-gold">taking.</em> Start here.</Fragment>}
    </h2>

    <div class="grid gap-5 md:grid-cols-2 md:gap-6">
      <div class="reveal flex flex-col gap-4 rounded-card border border-cream-100/20 p-8 md:p-11">
        <p class="text-[13px] font-medium uppercase tracking-eyebrow text-gold">New to Wyld Wandering</p>
        <h3 class="text-[36px]">Start Planning</h3>
        <p class="max-w-md text-pine-muted">A short intake sets up your traveler profile, so our first conversation is about the trip, not the paperwork.</p>
        <a href={INTAKE_URL} class="btn-primary mt-3 self-start" target="_blank" rel="noopener noreferrer">Begin the Intake <Icon name="arrow" class="h-[18px] w-[18px]" /></a>
      </div>

      <div class="reveal flex flex-col gap-4 rounded-card bg-sand-100 p-8 text-ink md:p-11">
        <p class="text-[13px] font-medium uppercase tracking-eyebrow text-clay-dark">Already a client</p>
        <h3 class="text-[36px]">Your Client Portal</h3>
        <p class="max-w-md text-ink-700">Sign in with your email or phone to browse and book hotels with me, perks included.</p>
        <a href={PORTAL_URL} class="btn-dark mt-3 self-start" target="_blank" rel="noopener noreferrer"><Icon name="lock" /> Client Login</a>
      </div>
    </div>

    <p class="text-[15px] text-cream-500">
      Just have a quick question? <a href="/contact#question" class="text-gold underline-offset-4 hover:text-gold-soft hover:underline">Send a Note</a> or email <a href={`mailto:${SITE.email}`} class="text-gold underline-offset-4 hover:text-gold-soft hover:underline">{SITE.email}</a>.
    </p>
  </div>
</section>
