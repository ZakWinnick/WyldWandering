---
import Logo from './Logo.astro';
import { getGuides } from '../lib/guides';
import { NAV_LINKS, INTAKE_URL, PORTAL_URL, SOCIAL, SITE, FORA_DISCLOSURE } from '../config/site';

// Guides joins the nav once the first guide is published.
const navLinks = (await getGuides()).length > 0
  ? [...NAV_LINKS.slice(0, 3), { href: '/guides', label: 'Guides' }, ...NAV_LINKS.slice(3)]
  : [...NAV_LINKS];

const year = new Date().getFullYear();
const label = 'text-xs font-medium uppercase tracking-[0.2em] text-cream-500';
const link = 'text-cream-100 hover:text-gold';
---

<footer class="bg-pine-deep pb-10 pt-16 text-[15px] text-pine-muted dark:border-t dark:border-sand-300 md:pt-20">
  <div class="container-site flex flex-col gap-14">
    <div class="flex flex-col justify-between gap-12 lg:flex-row">
      <div class="flex max-w-sm flex-col gap-5 text-cream-100">
        <Logo variant="stacked" class="h-[100px] w-auto self-start" />
        <p class="text-cream-500">Hotels you'll brag about. Itineraries you won't share. Premium travel planning for people who know the difference.</p>
        <div class="mt-2 flex items-center gap-3">
          <img src="/Fora_Logo_Wordmark_Sand_S.png" alt="Fora Travel" width="63" height="22" class="h-[22px] w-auto opacity-90" loading="lazy" />
          <span class="text-xs uppercase tracking-[0.18em] text-cream-500">Certified advisor</span>
        </div>
      </div>

      <div class="grid grid-cols-2 gap-10 sm:grid-cols-[auto_auto_auto] sm:gap-16">
        <nav aria-label="Footer" class="flex flex-col gap-3">
          <p class={label}>Explore</p>
          {navLinks.map((l) => <a href={l.href} class={link}>{l.label}</a>)}
          <a href="/contact" class={link}>Contact</a>
        </nav>
        <div class="flex flex-col gap-3">
          <p class={label}>Clients</p>
          <a href={INTAKE_URL} class={link} target="_blank" rel="noopener noreferrer">Start Planning</a>
          <a href={PORTAL_URL} class={link} target="_blank" rel="noopener noreferrer">Client Login</a>
          <a href="/services#pricing" class={link}>Pricing</a>
        </div>
        <div class="col-span-2 flex flex-col gap-3 sm:col-span-1">
          <p class={label}>Connect</p>
          <a href={`mailto:${SITE.email}`} class={link}>{SITE.email}</a>
          <a href={SOCIAL.instagram} class={link} target="_blank" rel="noopener noreferrer">Instagram</a>
          <a href={SOCIAL.x} class={link} target="_blank" rel="noopener noreferrer">X</a>
          <a href={SOCIAL.fora} class={link} target="_blank" rel="noopener noreferrer">Fora Profile</a>
        </div>
      </div>
    </div>

    <div class="flex flex-col gap-5 border-t border-cream-100/10 pt-7 text-[13px] leading-relaxed text-cream-500">
      <p class="max-w-4xl">
        {FORA_DISCLOSURE.affiliation} {FORA_DISCLOSURE.registrationsIntro} {FORA_DISCLOSURE.registrations.join('; ')}.
      </p>
      <div class="flex flex-col justify-between gap-3 md:flex-row">
        <p>&copy; {year} Wyld Wandering.</p>
        <p>Client portal and intake powered by Fora</p>
      </div>
    </div>
  </div>
</footer>
