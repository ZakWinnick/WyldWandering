---
// Text-led hero for inner pages. Put the title (with optional <em>) in the default slot.
interface Props {
  eyebrow: string;
  intro?: string;
}
const { eyebrow, intro } = Astro.props;
---

<section class="border-b border-sand-300 pb-16 pt-14 md:pb-24 md:pt-24">
  <div class="container-site grid items-end gap-10 lg:grid-cols-12">
    <div class="flex flex-col gap-6 lg:col-span-7">
      <p class="eyebrow">{eyebrow}</p>
      <h1 class="display-xl"><slot /></h1>
    </div>
    {
      intro && (
        <p class="lede max-w-xl lg:col-span-5 lg:pb-3">{intro}</p>
      )
    }
  </div>
  <slot name="after" />
</section>
